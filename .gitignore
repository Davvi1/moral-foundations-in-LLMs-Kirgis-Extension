# Large raw model outputs — regenerable from the pod, too big for git.
# Derived, analysis-ready files in results/derived/ ARE committed.
results/raw/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# Model weights — never commit these
*.safetensors
*.bin
*.gguf

# Built presentation — regenerable from committed figures with
# `python scripts/make_deck.py`. The SOURCE (make_deck.py) and the INPUTS
# (figures/) are committed; the binary is not, so it cannot drift from them
# unnoticed or bloat the history on every rebuild.
*.pptx

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets — nothing here should ever be committed
.env
*.pem
*_token*
!scripts/*token*

# Personal Claude Code permission grants — machine-specific, not part of the project
.claude/settings.local.json
